+def split_spoken_sentences(text: str) -> list[str]:
+    """批量回答按完整句子分组，不能把逗号分块或单字尾巴当成句数。"""
+    cleaned = clean_for_speech(text)
+    if not cleaned:
+        return []
+    ends = re.escape(STRONG_ENDS)
+    return [piece.strip() for piece in re.findall(
+        rf'.+?(?:[{ends}]+[”’」』）)\"]*|$)', cleaned, re.S
+    ) if piece.strip()]
