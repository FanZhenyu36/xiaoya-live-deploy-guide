+"""Local-only Chinese ASR worker, run with an existing FunASR Python environment."""
+import argparse
+import io
+import subprocess
+import threading
+from pathlib import Path
+import numpy as np
+from fastapi import FastAPI,Request,HTTPException
+import uvicorn
+
+app=FastAPI()
+model=None
+lock=threading.Lock()
+model_dir=None
+ffmpeg=None
+
+def transcribe(body):
+    global model
+    result=subprocess.run([str(ffmpeg),'-hide_banner','-loglevel','error','-i','pipe:0',
+        '-t','31','-vn','-ac','1','-ar','16000','-f','s16le','pipe:1'],
+        input=body,capture_output=True,timeout=20)
+    if result.returncode or not result.stdout:
+        raise ValueError('无法解码录音，请重新录制')
+    samples=np.frombuffer(result.stdout,dtype='<i2').astype(np.float32)/32768
+    if len(samples)>int(30.1*16000):raise ValueError('每次录音最长 30 秒')
+    if len(samples)<3200 or float(np.sqrt(np.mean(samples*samples)))<0.003:
+        return ''
+    with lock:
+        if model is None:
+            from funasr import AutoModel
+            model=AutoModel(model=str(model_dir),device='cpu',ncpu=4,
+                disable_update=True,disable_pbar=True,trust_remote_code=False)
+        results=model.generate(input=samples,cache={},disable_pbar=True)
+        return str(results[0].get('text') or '').strip() if results else ''
+
+@app.get('/health')
+def health():return {'ok':True,'kind':'xiaoya-local-asr','loaded':model is not None}
+
+@app.post('/api/stt')
+async def stt(request:Request):
+    import asyncio
+    body=await request.body()
+    if not body or len(body)>8*1024*1024:raise HTTPException(413,'录音为空或超过大小限制')
+    try:text=await asyncio.to_thread(transcribe,body)
+    except (ValueError,subprocess.TimeoutExpired) as exc:raise HTTPException(422,str(exc)) from exc
+    return {'text':text,'language':'zh'}
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser();p.add_argument('--model',type=Path,required=True)
+    p.add_argument('--ffmpeg',type=Path,required=True);p.add_argument('--port',type=int,default=8798)
+    a=p.parse_args();model_dir=a.model.resolve();ffmpeg=a.ffmpeg.resolve()
+    if not (model_dir/'model.pt').is_file() or not ffmpeg.is_file():raise SystemExit('ASR model/ffmpeg not found')
+    uvicorn.run(app,host='127.0.0.1',port=a.port)
