new file mode 100644
--- /dev/null
+++ b/src/audience.py
@@ -0,0 +1,55 @@
+"""直播观众队列：问题保序，欢迎低优先级，重连事件去重。"""
+from __future__ import annotations
+
+import collections
+import time
+
+
+class AudienceQueue:
+    def __init__(self, questions=None, question_limit=200, welcome_limit=80):
+        self.questions = questions if questions is not None else collections.deque()
+        self.welcomes = collections.deque()
+        self.question_limit = question_limit
+        self.welcome_limit = welcome_limit
+        self._events = collections.OrderedDict()
+        self._visitors = collections.OrderedDict()
+
+    def _seen(self, key: str, cache, ttl: float) -> bool:
+        now = time.monotonic()
+        while cache and (now - next(iter(cache.values())) >= ttl or len(cache) > 4096):
+            cache.popitem(last=False)
+        return bool(key and key in cache)
+
+    def add_question(self, item: dict, event_id: str = "") -> dict:
+        key = f"{item.get('platform', '')}:chat:{event_id}" if event_id else ""
+        if self._seen(key, self._events, 300):
+            return {"ok": True, "queued": False, "reason": "duplicate"}
+        if len(self.questions) >= self.question_limit:
+            return {"ok": False, "queued": False, "reason": "queue_full", "depth": len(self.questions)}
+        if key:
+            self._events[key] = time.monotonic()
+        self.questions.append(item)
+        return {"ok": True, "queued": True, "reason": "fifo", "depth": len(self.questions)}
+
+    def add_welcome(self, item: dict, uid: str = "", cooldown: float = 60) -> dict:
+        key = f"{item.get('platform', '')}:{uid or item.get('nick', '')}"
+        if self._seen(key, self._visitors, cooldown):
+            return {"ok": True, "queued": False, "reason": "welcome_duplicate"}
+        if len(self.welcomes) >= self.welcome_limit:
+            return {"ok": False, "queued": False, "reason": "welcome_queue_full"}
+        self._visitors[key] = time.monotonic()
+        self.welcomes.append(item)
+        return {"ok": True, "queued": True, "reason": "welcome", "depth": len(self.welcomes)}
+
+    def pop_next(self):
+        if self.questions:
+            return "question", self.questions.popleft()
+        if self.welcomes:
+            return "welcome", self.welcomes.popleft()
+        return None
+
+    def clear(self):
+        self.questions.clear()
+        self.welcomes.clear()
+        self._events.clear()
+        self._visitors.clear()
