+/* RTC_VIDEO_BINDING_BEGIN */
+function createRtcVideoBinding(engine, video, play, isCurrent = ()=>true){
+  const streams = new Map();
+  let bound = null;
+  function update(uid, track, subscription){
+    if (!isCurrent() || ![1, 2].includes(track)) return;
+    const status = Number(subscription);
+    if (status !== 3 && status !== 1) return;
+    const ready = streams.get(uid) || new Set();
+    if (status === 3) ready.add(track); else ready.delete(track);
+    if (ready.size) streams.set(uid, ready); else streams.delete(uid);
+    const chosen = ready.has(1) ? 1 : (ready.has(2) ? 2 : 0);
+    if (!chosen){
+      if (bound && bound.uid === uid) bound = null;
+      return;
+    }
+    if (bound && bound.uid === uid && bound.track === chosen) return;
+    try{
+      if (bound) engine.setRemoteViewConfig(null, bound.uid, bound.track);
+      bound = null;
+      engine.setRemoteViewConfig(video, uid, chosen);
+      bound = {uid, track:chosen};
+      play();
+    }catch(e){ console.warn("[RTC] 视频绑定失败", e); }
+  }
+  return {update, offline(uid){
+    streams.delete(uid);
+    if (bound && bound.uid === uid) bound = null;
+  }};
+}
